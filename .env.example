# Environment variables for Roadmap Nexus
DATABASE_URL="postgresql://username:password@localhost:5432/roadmap_nexus?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Site-wide password gate (leave SITE_ACCESS_PASSWORD empty to disable)
SITE_ACCESS_PASSWORD="change-me-before-deploy"
# Optional: signs access cookies (falls back to NEXTAUTH_SECRET)
SITE_ACCESS_SECRET="your-site-access-signing-secret"